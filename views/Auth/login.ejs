<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-10">
      <div class="max-w-xl mx-auto bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-rose-500 px-8 py-6 text-white">
          <h1 class="text-3xl font-bold text-center">Welcome back</h1>
          <p class="text-center mt-2 text-red-50">Sign in to continue managing your stays.</p>
        </div>

        <form action="/auth/login" method="POST" class="p-8 md:p-10 space-y-5">

          <% let loginError = null; %>
          <% if (typeof errors !== "undefined" && errors.length > 0) { %>
            <% loginError = errors[0]; %>
          <% } %>

          <% if (loginError) { %>
            <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
              <%= typeof loginError === "string" ? loginError : loginError.msg %>
            </div>
          <% } %>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email </label>
            <input
              id="email"
              type="email"
              name="email"
              required
             value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
              placeholder="Enter your email "
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400 focus:border-red-400 transition"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
            <input
              id="password"
              type="password"
              name="password"
              required
              placeholder="Enter your password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400 focus:border-red-400 transition"
            />
          </div>

          <button type="submit" class="w-full bg-red-500 text-white font-semibold py-3 rounded-lg hover:bg-red-600 transition duration-300 shadow-md hover:shadow-lg">
            Sign In
          </button>

          <div class="text-center mt-4">
            <span class="text-sm text-gray-600">Don’t have an account?</span>
            <a href="/auth/signup" class="ml-1 text-sm font-semibold text-red-500 hover:text-red-600 transition duration-300 underline">
              Sign Up
            </a>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>