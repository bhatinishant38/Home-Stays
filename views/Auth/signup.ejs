<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-10">
      <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-rose-500 px-8 py-6 text-white">
          <h1 class="text-3xl font-bold text-center">Create your account</h1>
          <p class="text-center mt-2 text-red-50">Register as a new user and get started instantly.</p>
        </div>

        <form action="/auth/signup" method="POST" class="p-8 md:p-10 space-y-5">
     <!-- 
             <% if (typeof errors !== "undefined" && errors.length > 0) { %>
              <div class="bg-red-100 border border-red-400 text px-4 py-3 rounded relative" role="alert">
                <strong class="font-bold">Error!</strong>
                <span class="block sm:inline">
                  <% errors.forEach(error => {  %>
                    <li> <%= error.msg %> </li>

                  <% }) %>
              </span>
              <span class="absolute top-0 bottom-0 right-0 px-4py-3">
                <i class="fas fa-times"></i>
              </span>
              </div> 
           <%  } %>  
     -->

          <% let firstNameError = null; %>
          <% let lastNameError = null; %>
          <% let emailError = null; %>
          <% let passwordError = null; %>
          <% let confirmPasswordError = null; %>
          <% let userTypeError = null; %>
          <% let termsError = null; %>

          <% if (typeof errors !== "undefined" && errors.length > 0) { %>
            <% errors.forEach((error) => { %>
              <% if (error.path === "firstName") { firstNameError = error; } %>
              <% if (error.path === "lastName") { lastNameError = error; } %>
              <% if (error.path === "email") { emailError = error; } %>
              <% if (error.path === "password") { passwordError = error; } %>
              <% if (error.path === "confirmPassword") { confirmPasswordError = error; } %>
              <% if (error.path === "userType") { userTypeError = error; } %>
              <% if (error.path === "terms") { termsError = error; } %>
            <% }) %>
          <% } %>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="firstName" class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
              <input
                id="firstName"
                type="text"
                name="firstName"
                required
                placeholder="Enter your first name"
                value="<%= typeof oldInput !== 'undefined' && oldInput.firstName ? oldInput.firstName : '' %>"
                class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 transition <%= firstNameError ? 'border-red-500 focus:ring-red-400 focus:border-red-500' : 'border-gray-300 focus:ring-red-400 focus:border-red-400' %>"
              />
              <% if (firstNameError) { %>
                <p class="mt-1 text-sm text-red-500"><%= firstNameError.msg %></p>
              <% } %>
            </div>

            <div>
              <label for="lastName" class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
              <input
                id="lastName"
                type="text"
                name="lastName"
                placeholder="Enter your last name"
                value="<%= typeof oldInput !== 'undefined' && oldInput.lastName ? oldInput.lastName : '' %>"
                class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 transition <%= lastNameError ? 'border-red-500 focus:ring-red-400 focus:border-red-500' : 'border-gray-300 focus:ring-red-400 focus:border-red-400' %>"
              />
              <% if (lastNameError) { %>
                <p class="mt-1 text-sm text-red-500"><%= lastNameError.msg %></p>
              <% } %>
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              placeholder="test@email.com"
              value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
              class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 transition <%= emailError ? 'border-red-500 focus:ring-red-400 focus:border-red-500' : 'border-gray-300 focus:ring-red-400 focus:border-red-400' %>"
            />
            <% if (emailError) { %>
              <p class="mt-1 text-sm text-red-500"><%= emailError.msg %></p>
            <% } %>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
              <input
                id="password"
                type="password"
                name="password"
                required
                placeholder="Enter your password"
                value="<%= typeof oldInput !== 'undefined' && oldInput.password ? oldInput.password : '' %>"
                class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 transition <%= passwordError ? 'border-red-500 focus:ring-red-400 focus:border-red-500' : 'border-gray-300 focus:ring-red-400 focus:border-red-400' %>"
              />
              <% if (passwordError) { %>
                <p class="mt-1 text-sm text-red-500"><%= passwordError.msg %></p>
              <% } %>
            </div>

            <div>
              <label for="confirmPassword" class="block text-sm font-semibold text-gray-700 mb-2">Confirm Password</label>
              <input
                id="confirmPassword"
                type="password"
                name="confirmPassword"
                required
                placeholder="Confirm your password"
                class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 transition <%= confirmPasswordError ? 'border-red-500 focus:ring-red-400 focus:border-red-500' : 'border-gray-300 focus:ring-red-400 focus:border-red-400' %>"
              />
              <% if (confirmPasswordError) { %>
                <p class="mt-1 text-sm text-red-500"><%= confirmPasswordError.msg %></p>
              <% } %>
            </div>
          </div>

          <div class="pt-2">
            <p class="text-sm font-semibold text-gray-700 mb-3">Select user type</p>
            <div class="flex flex-col sm:flex-row gap-3">
              <label class="flex items-center gap-2 bg-gray-50 px-4 py-3 rounded-lg border border-gray-200 w-full sm:w-auto">
                <input type="radio" name="userType" value="guest" class="accent-red-500">
                <span class="text-gray-700">Guest</span>
              </label>
              <label class="flex items-center gap-2 bg-gray-50 px-4 py-3 rounded-lg border border-gray-200 w-full sm:w-auto">
                <input type="radio" name="userType" value="host" class="accent-red-500">
                <span class="text-gray-700">Host</span>
              </label>
            </div>
            <% if (userTypeError) { %>
              <p class="mt-1 text-sm text-red-500"><%= userTypeError.msg %></p>
            <% } %>
          </div>

          <div class="pt-2">
            <label class="flex items-start gap-3 bg-gray-50 px-4 py-3 rounded-lg border border-gray-200">
              <input type="checkbox" name="terms" class="mt-1 accent-red-500">
              <span class="text-sm text-gray-700">I agree to the terms and conditions and privacy policy.</span>
            </label>
            <% if (termsError) { %>
              <p class="mt-1 text-sm text-red-500"><%= termsError.msg %></p>
            <% } %>
          </div>

          <button type="submit" class="w-full bg-red-500 text-white font-semibold py-3 rounded-lg hover:bg-red-600 transition duration-300 shadow-md hover:shadow-lg">
            Register
          </button>

          <div class="text-center mt-4">
            <span class="text-sm text-gray-600">Already have an account?</span>
            <a href="/auth/login" class="ml-1 text-sm font-semibold text-red-500 hover:text-red-600 transition duration-300 underline">
              Login
            </a>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>