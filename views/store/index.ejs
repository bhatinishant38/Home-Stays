<%- include('../partials/head') %>
  </head>
  <body class="bg-slate-50 text-slate-700">
    <%- include('../partials/nav') %>
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <section class="overflow-hidden rounded-[32px] border border-slate-200 bg-white shadow-[0_20px_45px_-20px_rgba(15,23,42,0.35)]">
        <div class="bg-gradient-to-r from-rose-50 to-white px-6 py-8 sm:px-8 lg:px-10">
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.3em] text-rose-500">Stay in comfort</p>
          <h2 class="text-3xl font-bold text-slate-800 sm:text-4xl">Discover homes that feel just right</h2>
          <p class="mt-3 max-w-2xl text-sm text-slate-600 sm:text-base">Browse a refined collection of homes with beautiful design, great locations, and a welcoming feel.</p>
        </div>

        <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-3">
          <% registeredHomes.forEach(home => { %>
            <div class="overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">
              <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="h-48 w-full object-cover">
              <div class="p-5">
                <h3 class="text-xl font-semibold text-slate-800"><%= home.houseName %></h3>
                <p class="mt-2 text-sm text-slate-600"><i class="fas fa-map-marker-alt mr-2"></i><%= home.location %></p>
                <div class="mt-4 flex items-center justify-between">
                  <span class="text-lg font-bold text-rose-500">Rs <%= home.price %> / night</span>
                  <div class="flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-sm font-semibold text-amber-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mr-1 h-4 w-4">
                      <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                    </svg>
                    <span><%= home.rating %></span>
                  </div>
                </div>
                <div class="mt-5 flex items-center gap-3">

                  <button class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition duration-300 hover:bg-slate-50">Book</button>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>