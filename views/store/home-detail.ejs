<%- include('../partials/head') %>
  </head>
  <body class="bg-slate-50 text-slate-700">
    <%- include('../partials/nav') %>
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <section class="overflow-hidden rounded-[32px] border border-slate-200 bg-white shadow-[0_20px_45px_-20px_rgba(15,23,42,0.35)]">
        <div class="border-b border-slate-100 bg-gradient-to-r from-rose-50 to-white p-6 sm:p-8">
          <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
              <p class="mb-2 text-sm font-semibold uppercase tracking-[0.3em] text-rose-500">Featured stay</p>
              <h2 class="text-3xl font-bold text-slate-800 sm:text-4xl"><%= home.name %></h2>
              <p class="mt-2 max-w-2xl text-sm text-slate-600 sm:text-base">Discover an inviting place designed for comfort and memorable stays.</p>
            </div>
            <div class="inline-flex items-center rounded-full bg-amber-100 px-3 py-2 text-sm font-semibold text-amber-700">
              <span class="mr-1 text-base">★</span>
              <span><%= home.rating %> / 5</span>
            </div>
          </div>
        </div>

        <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.15fr_0.85fr]">
          <div class="overflow-hidden rounded-[24px] shadow-md">
            <img src="<%= home.photo %>" alt="<%= home.name %>" class`h-[420px] w-full object-cover` />
          </div>

          <div class="flex flex-col gap-4">
            <div class="rounded-[20px] border border-slate-200 bg-slate-50 p-5">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Starting at</p>
                  <p class="mt-1 text-3xl font-bold text-slate-800">$<%= home.price %></p>
                </div>
                <div class="rounded-full bg-emerald-100 px-3 py-2 text-sm font-semibold text-emerald-700">Per night</div>
              </div>
            </div>

            <div class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-sm">
              <h3 class="text-xl font-semibold text-slate-800">About this place</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base"><%= home.description %></p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-sm">
                <h3 class="text-lg font-semibold text-slate-800">Location</h3>
                <p class="mt-2 text-sm text-slate-600"><%= home.location %></p>
              </div>

              <div class="rounded-[20px] border border-slate-200 bg-white p-5 shadow-sm">
                <h3 class="text-lg font-semibold text-slate-800">Guest experience</h3>
                <p class="mt-2 text-sm text-slate-600">Comfort, convenience, and memorable stays.</p>
              </div>
            </div>

            <div class="rounded-[20px] border border-rose-100 bg-rose-50 p-5">
              <%- include('../partials/favourites') %>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>