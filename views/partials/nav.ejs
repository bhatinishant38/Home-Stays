<header class="border-b border-white/20 bg-gradient-to-r from-rose-500 via-red-500 to-rose-600 text-white shadow-[0_10px_30px_-15px_rgba(0,0,0,0.45)]">
  <nav class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2 rounded-full bg-white/15 px-4 py-2 backdrop-blur-sm transition duration-300 hover:bg-white/25">
          <span class="text-lg font-bold tracking-wide">Home Stay</span>
        </a>
      </div>

      <!-- Desktop Menu (hidden below 640px) -->
      <ul class="hidden sm:flex text-sm font-medium items-center gap-3">
        <% if (isLoggedIn) { %>
          <% if (user && user.userType ==="guest"){  %>
            <li>
              <a href="/homes"
                class="<%= currentPage === 'homes' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> rounded-full px-4 py-2 transition duration-300">
                Homes List
              </a>
            </li>

            <li>
              <a href="/favourites"
                class="<%= currentPage === 'favourites' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> rounded-full px-4 py-2 transition duration-300">
                Favourites
              </a>
            </li>

            <li>
              <a href="/bookings"
                class="<%= currentPage === 'bookings' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> rounded-full px-4 py-2 transition duration-300">
                Bookings
              </a>
            </li>
          <% } else { %>
            <li>
              <a href="/host/host-home-list"
                class="<%= currentPage === 'Host Homes' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> rounded-full px-4 py-2 transition duration-300">
                Host Homes
              </a>
            </li>

            <li>
              <a href="/host/add-home"
                class="<%= currentPage === 'addhome' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> rounded-full px-4 py-2 transition duration-300">
                Add Home
              </a>
            </li>
          <% } %>
        <% } %>

        <% if (!isLoggedIn) { %>
          <li>
            <a href="/auth/login"
              class="<%= currentPage === 'login' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> rounded-full px-4 py-2 transition duration-300">
              Log In
            </a>
          </li>

          <li>
            <a href="/auth/signup"
              class="<%= currentPage === 'signup' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> rounded-full px-4 py-2 transition duration-300">
              Sign Up
            </a>
          </li>
        <% } else { %>
          <li>
            <form action="/auth/logout" method="post">
              <button type="submit" class="rounded-full bg-white/10 px-4 py-2 transition duration-300 hover:bg-white/20">
                Logout
              </button>
            </form>
          </li>
        <% } %>
      </ul>

      <!-- Mobile Burger Menu Button (visible below 640px) -->
      <button id="mobileMenuBtn" class="sm:hidden p-2 rounded-lg bg-white/10 hover:bg-white/20 transition duration-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu (hidden by default, shown on burger click) -->
    <div id="mobileMenu" class="hidden sm:hidden flex-col gap-3 mt-4 pb-4">
      <% if (isLoggedIn) { %>
        <% if (user && user.userType ==="guest"){  %>
          <a href="/homes"
            class="<%= currentPage === 'homes' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> block rounded-full px-4 py-2 text-sm font-medium transition duration-300">
            Homes List
          </a>

          <a href="/favourites"
            class="<%= currentPage === 'favourites' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> block rounded-full px-4 py-2 text-sm font-medium transition duration-300">
            Favourites
          </a>

          <a href="/bookings"
            class="<%= currentPage === 'bookings' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> block rounded-full px-4 py-2 text-sm font-medium transition duration-300">
            Bookings
          </a>
        <% } else { %>
          <a href="/host/host-home-list"
            class="<%= currentPage === 'Host Homes' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> block rounded-full px-4 py-2 text-sm font-medium transition duration-300">
            Host Homes
          </a>

          <a href="/host/add-home"
            class="<%= currentPage === 'addhome' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> block rounded-full px-4 py-2 text-sm font-medium transition duration-300">
            Add Home
          </a>
        <% } %>
      <% } %>

      <% if (!isLoggedIn) { %>
        <a href="/auth/login"
          class="<%= currentPage === 'login' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> block rounded-full px-4 py-2 text-sm font-medium transition duration-300">
          Log In
        </a>

        <a href="/auth/signup"
          class="<%= currentPage === 'signup' ? 'bg-white text-rose-600' : 'bg-white/10 hover:bg-white/20' %> block rounded-full px-4 py-2 text-sm font-medium transition duration-300">
          Sign Up
        </a>
      <% } else { %>
        <form action="/auth/logout" method="post" class="w-full">
          <button type="submit" class="w-full text-left rounded-full bg-white/10 px-4 py-2 text-sm font-medium transition duration-300 hover:bg-white/20">
            Logout
          </button>
        </form>
      <% } %>
    </div>
  </nav>

  <script>
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    mobileMenuBtn.addEventListener('click', function() {
      mobileMenu.classList.toggle('hidden');
      mobileMenu.classList.toggle('flex');
    });

    // Close menu when a link is clicked
    const menuLinks = mobileMenu.querySelectorAll('a');
    menuLinks.forEach(link => {
      link.addEventListener('click', function() {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
      });
    });
  </script>
</header>